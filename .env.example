VITE_USE_BACKEND=true
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_PERSONNEL_LIVE=false

# 实时同步频率（毫秒）：
#   VITE_REALTIME_POLL_INTERVAL  设备/灾害点/汇总基础轮询（兜底）
#   VITE_WARNING_POLL_INTERVAL   预警核心数据高频轮询（默认 10s）
#   VITE_PERSONNEL_POLL_INTERVAL 值守人员位置轮询（位置变化慢，低频即可）
#   VITE_USE_PERSONNEL_LIVE      生产模式：人员坐标由移动端上报后端（true），
#                                演示模式：false 时前端从人员档案本地模拟轨迹
#   VITE_WS_URL                  WebSocket 实时推送地址（预警/设备/人员增量）
VITE_REALTIME_POLL_INTERVAL=15000
VITE_WARNING_POLL_INTERVAL=10000
VITE_PERSONNEL_POLL_INTERVAL=30000
VITE_USE_PERSONNEL_LIVE=false
VITE_WS_URL=

# =============== 安全配置（生产必须修改）===============
# ⚠️  JWT_SECRET：强随机密钥（长度 ≥ 32）
#     生成方式：openssl rand -base64 48
#     应用启动时会校验，若检测到弱密钥将拒绝启动。
#     prod 下 ProductionConfigValidator 会拦截所有 CHANGE_ME* 占位值，
#     本模板值仅可用于本地开发，照抄不改无法启动 prod。
# ⚠️  JWT_EXPIRE：ISO 8601 Duration 格式，勿使用分钟数字
#     PT24H  = 24小时（推荐）  PT2H = 2小时  PT30M = 30分钟
JWT_SECRET=CHANGE_ME__dev_only_minimum_32_character_secret_key_2026
JWT_EXPIRE=PT24H

# ⚠️ 已废弃：JWT_EXPIRE_MINUTES 不再使用（改用 ISO 8601 Duration 的 JWT_EXPIRE）
# JWT_EXPIRE_MINUTES=120

# ⚠️  DATA_ENCRYPTION_KEY：注册申请身份证号的 AES-256-GCM 加密密钥（长度 ≥ 32）
#     prod 下缺失会被 ProductionConfigValidator 阻断启动；
#     dev 留空则生成一次性随机密钥（重启后旧密文无法解密）。
#     生成方式：openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# 注册申请短信/邮箱验证码下发开关（默认 false = 未接入网关）。
# false 时：dev 打日志降级联调，prod 明确返回 50301「验证码服务未配置」。
# ⚠️ 网关尚未接入，prod 置 true 会被 ProductionConfigValidator 阻断。
REGISTER_SMS_ENABLED=false
REGISTER_EMAIL_ENABLED=false

# 现阶段通知投递白名单：只允许投递给项目测试成员。
# 逗号分隔，可填手机号 / 邮箱 / 设备 Token / 用户名，必须与请求里的 target 完全一致（忽略大小写与空格）。
# 留空 = 所有对外投递一律 BLOCKED（fail-closed），不会误发给外部人员。
# ⚠️ 该配置只做准入控制，不代表已接入真实网关：WebhookSender 已发起真实 HTTP POST，
#    但短信 / 邮件等 Sender 仍为演示实现（mock），不会产生对外投递。
# ⚠️ 只有短信真实网关已接入（ALIYUN_SMS_ENABLED=true 且 access-key-id 非 CHANGE_ME）时，
#    注册验证码下发才受本名单约束；邮箱 Sender 仍是演示实现，不产生对外投递。
#    REGISTER_SMS_ENABLED / REGISTER_EMAIL_ENABLED 只控制注册验证码开关，不是网关开关。
# 示例：NOTIFICATION_TEST_RECIPIENTS=13800000000,tester@example.com
NOTIFICATION_TEST_RECIPIENTS=

SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
# 宿主机浏览器访问 MinIO 的端口：docker-compose.yml 把容器内 9000 映射到 19000，
# application.yml 的默认值也是 http://localhost:19000。写成 9000 会让附件 /
# AI 图像链接指向一个没有监听的端口。
FILE_BASE_URL=http://localhost:19000

# ============ 阿里云号码认证服务配置（短信验证码）============
# 使用号码认证服务无需企业资质，个人开发者可直接使用系统赠送的测试签名和模板。
# 注册入口：https://www.aliyun.com/product/dypnsapi
# RAM 凭证获取：https://ram.console.aliyun.com/manage/ak
#
# ⚠️ 配置前必需：
#   1. 在阿里云控制台确认 AccessKey 有效且 RAM 权限包含 AliyunDypnsFullAccess 或自定义策略
#   2. 签名和模板应使用阿里云赠送的默认值（无需另行申请）
#
# 模板内容示例：
#   您的验证码为${code}。尊敬的客户，以上验证码${min}分钟内有效，请注意保密。
#
# 生产环境部署建议：
#   - 凭证通过环境变量 ALIYUN_SMS_ACCESS_KEY_ID / ALIYUN_SMS_ACCESS_KEY_SECRET 注入
#   - 定期轮换 AccessKey
#   - RAM 策略限制到 SendSmsVerifyCode 操作
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com

# =============== PostgreSQL ===============
# 端口说明：容器内固定 5432，docker-compose.yml 映射到宿主机 15432。
# 本文件供宿主机直跑 / start-dev.* 使用，这里必须是 15432；
# 写成 5432 会让 `mvn spring-boot:run` 连不上数据库。
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=disasterguard
POSTGRES_USER=disasterguard
# ⚠️ 必须与 docker-compose.yml 的默认口令同源，否则「不设环境变量」时
#    容器用 CHANGE_ME__dev... 初始化、后端却拿另一个口令去连（表现为鉴权失败）。
#    生产环境必须修改为强随机密码。
POSTGRES_PASSWORD=CHANGE_ME__dev_postgres_password_2026

# =============== Redis ===============
# 同理：容器内 6379，宿主机映射 16379。
REDIS_HOST=localhost
REDIS_PORT=16379
# ⚠️ 生产环境必须修改为强随机密码（长度 ≥ 16）
#     生成方式：openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24

# =============== MinIO 对象存储 ===============
# ⚠️ 生产环境必须修改为强随机凭证（长度 ≥ 24）
#     生成方式：openssl rand -base64 32
MINIO_ROOT_USER=disasterguard
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
# 容器内固定 9000 / 9001，宿主机映射到 19000 / 19001（见 docker-compose.yml）。
# compose 实际读取的是 *_HOST_PORT；旧的 MINIO_API_PORT=9000 是无人消费的死配置，
# 且会误导使用者从浏览器去访问 9000 这个没有映射的端口。
MINIO_API_HOST_PORT=127.0.0.1:19000
MINIO_CONSOLE_HOST_PORT=127.0.0.1:19001

# =============== EMQX MQTT Broker ===============
# ⚠️ 生产环境必须修改为强随机密码（长度 ≥ 16）
#     生成方式：openssl rand -base64 24
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
# docker-compose.prod.yml 用 ${EMQX_NODE_COOKIE:?...} 强制注入，留空会让 prod
# 在 compose 解析阶段直接失败（dev compose 有默认值，留空不影响本地开发）。
# 部署前生成：openssl rand -hex 32
EMQX_NODE_COOKIE=
EMQX_USERNAME=disasterguard_backend
# ⚠️ 同一组值必须同步给 prod compose 的 emqx / backend 两个服务；
#    任何未替换的 CHANGE_ME* 占位值在 prod 会被 ProductionConfigValidator 拦截。
EMQX_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
# MQTT 是设备/沙盘的主数据通道，必须与 application.yml 的 emqx.enabled 同源（R10 P1-6）
#   关成 false 时后端不订阅 disasterguard/+/data，前端看到的就是"一条数据都不进来"
EMQX_ENABLED=true
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_HTTP_PORT=18083

# =============== TDengine 时序数据库 ===============
TDENGINE_TCP_PORT=6030
TDENGINE_HTTP_PORT=6041
TZ=Asia/Shanghai

# ============ AI 推理服务（ai-service，FastAPI）============
# 后端调用 AI 服务的基准地址；Docker 网络内为 http://ai-service:8001/api/ai
# ⚠️ AI 服务端口：compose 中映射为宿主机 8001（ai-service 容器内始终 8001）
# ⚠️ 仅宿主机直跑生效：docker-compose.prod.yml 已把 backend 的
#    AI_SERVICE_BASE_URL / AI_IMAGE_SERVICE_URL 固定为容器服务名，不读取本变量，
#    避免把 localhost:8001 注入容器后指向 backend 自身、AI 链路静默中断。
AI_SERVICE_BASE_URL=http://localhost:8001/api/ai
AI_HOST_PORT=8001
AI_ENABLED=true
AI_TIMEOUT_MS=30000
# 定时批量预测（默认关闭，开启后每天凌晨 2 点对启用的设备做预测）
AI_SCHEDULER_ENABLED=false
AI_FORECAST_HORIZON=7
AI_FORECAST_CRON=0 0 2 * * *

# ============ v1.7.0 AI 实时灾害监测（全国版）============
# 从 region 表动态加载监控区域（town/village 级别且 geo_type 非 PLAIN），
# 不依赖接入设备，AI 单独基于当地地理状况 + 天气状况输出关注/预警/异常严重结论。
#   AI_HAZARD_MONITOR_ENABLED         是否启用（默认 true）
#   AI_HAZARD_MONITOR_INTERVAL_MS    调度间隔（默认 90000ms = 90s）
#   AI_HAZARD_MONITOR_INITIAL_DELAY_MS  启动后首次执行延迟（默认 8000ms）
#   AI_HAZARD_MONITOR_MAX_REGIONS    每次最多扫描 region 数（默认 200，防超载）
#   AI_HAZARD_MONITOR_INCLUDE_PLAIN  是否包含 PLAIN（平原低风险区，默认 false 跳过）
#   AI_HAZARD_MONITOR_MIN_LEVEL      最小行政级别过滤：town（默认）/ village / district
#   AI_HAZARD_MONITOR_MIN_RISK_LEVEL AI 检测阈值：HIGH（默认）/ MEDIUM / LOW
AI_HAZARD_MONITOR_ENABLED=true
AI_HAZARD_MONITOR_INTERVAL_MS=90000
AI_HAZARD_MONITOR_INITIAL_DELAY_MS=8000
AI_HAZARD_MONITOR_MAX_REGIONS=200
AI_HAZARD_MONITOR_INCLUDE_PLAIN=false
AI_HAZARD_MONITOR_MIN_LEVEL=town
AI_HAZARD_MONITOR_MIN_RISK_LEVEL=HIGH

# ============ 地图瓦片供应商凭证 ============
# 高德地图（推荐，国内合规 + 国产高分卫星实景）：
#   VITE_AMAP_TOKEN          申请入口 https://lbs.amap.com/api/jsapi-v2/guide/abc/prepare
#                            选「Web 端 (JS API)」类型，控制台为该 Key 配置 Referer 白名单
#   VITE_AMAP_SECURITY_JS_CODE  AMap JS API 安全密钥；仅在使用官方 JS SDK 时需要
# 留空时自动降级到天地图 → ESRI Clarity；安全起见请把真实值放进本机 .env 或 .env.local
VITE_AMAP_TOKEN=请在高德开放平台申请 key 后替换此处占位
VITE_AMAP_SECURITY_JS_CODE=

# 天地图（兜底中的合规选项）：
VITE_TDT_TOKEN=
VITE_TDT_TK=

# 自定义降级源（最后兜底；不建议改）：
VITE_MAP_TILE_URL=
VITE_SATELLITE_TILE_URL=

# 渲染分辨率倍率（默认随设备；想压测/降级可显式覆盖）：
# VITE_MAP_PIXEL_RATIO=1.5

# ============ 卫星图源配置（v1.7.1 升级到"最新状态"）============
# 默认按下列优先级自动选源：
#   ① 用户显式配置 VITE_SATELLITE_TILE_URL（自定义图源）
#   ② 高德 style=6 scale=2（512px @2x，GCJ-02，2024+ 升级）
#   ③ 天地图 img_w（256px，CGCS2000，2024+ 重摄）
#   ④ ESRI Clarity（512px，WGS-84，2024-Q4 重摄，默认兜底）
#   ⑤ Mapbox Satellite-v9（256px，需配置 VITE_MAPBOX_TOKEN）
#   ⑥ Sentinel-2 真彩合成（256px，每 5 天更新无云）
#   ⑦ Google Maps 卫星（256px，备用）
#
# 自定义图源 URL（{z}/{x}/{y} 占位）：
# VITE_SATELLITE_TILE_URL=
# VITE_SENTINEL_TILE_URL=
#
# Mapbox token（可选，启用后优先级提升到第 5 位）：
#   申请入口 https://account.mapbox.com/access-tokens/
# VITE_MAPBOX_TOKEN=

# ============ 国家气象数据接入（NSMC + NMC 公开资源）============
# 后端 Java 服务相关配置（cn.disasterguard.weather.Service）：
#   WEATHER_CACHE_ENABLED      是否缓存最新帧探测结果，默认 true
#   WEATHER_CACHE_TTL_SECONDS  缓存存活秒数，默认 300 秒（5 分钟）
#   WEATHER_PROXY_ENABLED      是否启用 /api/weather/image/{kind} 代理接口，默认 true
WEATHER_CACHE_ENABLED=true
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_PROXY_ENABLED=true

# 前端气象数据接入模式：与总开关 VITE_USE_BACKEND 联动。
#   VITE_USE_BACKEND=true  → 气象走 /api/weather/* 后端代理（生产推荐，统一缓存 / 减少对外网并发）
#   VITE_USE_BACKEND=false → 浏览器直连 NSMC XML + NMC 静态产品 URL，CORS 由内置
#                             allorigins/codetabs/corsproxy 三级代理兜底（适合无后端场景）
# 详见 docs/DEVELOPER.md §17。

# ============ Copernicus Data Space（CDSE，ESA 官方 STAC + 数据）============
# 注册/管理 OAuth client：https://dataspace.copernicus.eu/profile/applications
# 点 "+ Create"，Name 任取，Application type 选 "Confidential"，勾上
# grant type "Client credentials"，Submit。创建后立即复制 Client ID + Client Secret
# （secret 只显示一次，重新生成请到详情页点 Regenerate secret）。
#
# 注意（2026-09-14 核对）：账号状态若显示 "Valid until YYYY-MM-DD"，则账号本身在
# 该时间后停用；已创建的 OAuth client 通常会同步失效，需要提前 rotate 或重新注册。
#
# ai-service 启动时会自动从 ai-service/.env 或本文件读取 COPERNICUS_CLIENT_*；
# 若留空则完全跳过 CDSE，自动降级到 Element84 Earth Search AWS + USGS Earthdata CMR
# 这两个公开 STAC，Sentinel-2 L2A / Sentinel-1 GRD 仍能正常返回（数据是同一份镜像）。
COPERNICUS_CLIENT_ID=sh-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COPERNICUS_CLIENT_SECRET=替换成从 profile/applications 复制的 secret（只显示一次）
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/

# ============ 后端 application.yml 占位符清单（补充）============
# 说明：application.yml 中所有敏感项都写成 ${变量名:本地开发默认值}。
#   不设置这些变量时，本地开发会使用 yml 里的默认值，直接 mvn spring-boot:run 可跑通；
#   生产必须逐项注入，否则 ProductionConfigValidator 会在 prod profile 下拒绝启动
#   （凡以 CHANGE_ME 开头的默认值都会被判定为「未配置」）。
#
# 生成强随机值：
#   JWT_SECRET            openssl rand -base64 48
#   DATA_ENCRYPTION_KEY   openssl rand -base64 32
#   POSTGRES_PASSWORD     openssl rand -base64 24
#   REDIS_PASSWORD        openssl rand -base64 24
#   MINIO_ROOT_PASSWORD   openssl rand -base64 32

# --- 运行模式（prod profile 会强制 dev-users-enabled=false / auth-strict=true / require-ticket=true）---
DEV_USERS_ENABLED=true
DEVICE_AUTH_STRICT=false
WS_REQUIRE_TICKET=false

# --- JWT ---
JWT_ISSUER=disasterguard

# --- 对象存储访问地址（同时用于生成附件预签名 URL，必须是浏览器可达地址）---
MINIO_ENDPOINT=http://localhost:19000
# 生产部署额外变量：prod compose 不读取上面的 FILE_BASE_URL（那是宿主机直跑用的），
# 改用 MINIO_PUBLIC_URL 作为附件访问基址。部署时设为浏览器可达的公网地址，
# 并把 MINIO_ENDPOINT_PROD 设为同一地址、把域名加入 DETECT_IMAGE_ALLOWED_HOSTS。
MINIO_BUCKET=disasterguard
# 兼容两套命名：MINIO_ACCESS_KEY / MINIO_SECRET_KEY 优先，其次 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# MINIO_ACCESS_KEY=disasterguard
# MINIO_SECRET_KEY=

# --- TDengine（默认关闭）---
TDENGINE_ENABLED=false
TDENGINE_URL=jdbc:TAOS-RS://localhost:16041/disasterguard
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=taosdata

# --- 外部数据源（气象 / 地震 / 高程 / 卫星）---
EXTERNAL_DATA_ENABLED=true
EXTERNAL_DATA_TIMEOUT=10
EXTERNAL_DATA_CACHE_TTL=300
EXTERNAL_DATA_SOURCES=openmeteo,usgs,openelevation,gdacs,osm,gpm,smap,copernicus

# --- AI 图像识别（独立于 AI_SERVICE_BASE_URL，可单独指向带 GPU 的实例）---
# AI_IMAGE_SERVICE_URL=http://127.0.0.1:8001/api/ai/detect-image


