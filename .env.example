VITE_USE_BACKEND=true
VITE_API_BASE_URL=http://localhost:8081/api
VITE_USE_PERSONNEL_LIVE=false

# 实时同步频率（毫秒）：
#   VITE_REALTIME_POLL_INTERVAL  设备/灾害点/汇总基础轮询（兜底）
#   VITE_WARNING_POLL_INTERVAL   预警核心数据高频轮询（默认 10s）
#   VITE_PERSONNEL_POLL_INTERVAL 值守人员位置轮询（位置变化慢，低频即可）
#   VITE_USE_PERSONNEL_LIVE      生产模式：人员坐标由移动端上报后端（true），
#                                演示模式：false 时前端从人员档案本地模拟轨迹
#   VITE_WS_URL                  WebSocket 实时推送地址（预警/设备/人员增量）
VITE_REALTIME_POLL_INTERVAL=15000
VITE_WARNING_POLL_INTERVAL=10000
VITE_PERSONNEL_POLL_INTERVAL=30000
VITE_USE_PERSONNEL_LIVE=false
VITE_WS_URL=

SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=120
FILE_BASE_URL=http://localhost:9000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geosentry
POSTGRES_USER=geosentry
POSTGRES_PASSWORD=geosentry123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=emqx123
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_HTTP_PORT=18083

TDENGINE_TCP_PORT=6030
TDENGINE_HTTP_PORT=6041
TZ=Asia/Shanghai

# ============ AI 推理服务（ai-service，FastAPI）============
# 后端调用 AI 服务的基准地址；Docker 网络内为 http://ai-service:8000/api/ai
AI_SERVICE_BASE_URL=http://localhost:8000/api/ai
AI_HOST_PORT=8000
AI_ENABLED=true
AI_TIMEOUT_MS=30000
# 定时批量预测（默认关闭，开启后每天凌晨 2 点对启用的设备做预测）
AI_SCHEDULER_ENABLED=false
AI_FORECAST_HORIZON=7
AI_FORECAST_CRON=0 0 2 * * *

