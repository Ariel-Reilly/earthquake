# AI 服务（FastAPI）本地 .env 模板
#
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入真实值（CDSE 凭证 / JWT 等敏感信息）
#   3. .env 默认应在 .gitignore 中（确认下：git status .env 应不显示）
#   4. 启动时 ai-service/app/main.py 会自动 load_dotenv() 加载本文件，
#      并回退到项目根 .env 补充共享配置（POSTGRES_HOST 等）
#
# 优先级（环境变量 > ai-service/.env > 项目根 .env），已存在的环境变量不会被覆盖

# ============ CORS ============
# 逗号分隔,默认允许 Vite 前端;生产环境改成 https://your-domain.com
AI_CORS_ORIGINS=http://localhost:5173

# ============ Copernicus Data Space（核心）============
# 注册入口：https://dataspace.copernicus.eu/profile/applications
# 注意：账号状态显示 "Valid until YYYY-MM-DD HH:MM" 的，OAuth client 也会同步停用
COPERNICUS_CLIENT_ID=sh-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/

# ============ Sentinel 合成图存储 ============
# 本地输出目录(相对 ai-service/ 根)
SENTINEL_STORAGE_DIR=outputs/sentinel
# 静态文件 URL 前缀(后端把 file:// 包成 http:// 让前端 OL 能直接 <img>)
SENTINEL_CDN_BASE=http://localhost:8001/sentinel_files

# ============ Google Earth Engine（可选）============
# 仅 provider=gee 时使用,需要先 earthengine authenticate --project YOUR_PROJ
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  ← 一整行 JSON
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT=projects/earth-engine-public-data
