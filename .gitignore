ai-service/models/*.pth
ai-service/models/*.h5
ai-service/models/*.pkl
ai-service/models/*.joblib
ai-service/models/*.bin
# 训练历史快照（每次训练保留上一版本即可，正式目录只放最新版）
ai-service/models/history/
ai-service/models/_torch_cache/
# ai-service 根目录临时拉取的 yolov8n 系列（download_models.py 输出）
ai-service/yolov8n.pt
ai-service/yolov8n.onnx
ai-service/yolov8n.onnx.data
