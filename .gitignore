*-out.txt
*.out.txt
# 早期调试遗留的 GBK/UTF-8 输出 & 报告
*-report.txt
*-log.txt
# 临时 SQL 片段（probe-stmt*.ps1 抽取 schema.sql 片段调试，产物不入库）
statement*.sql
