# 多阶段构建：前端生产镜像
# Stage 1: 构建
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
# 构建时的环境变量通过 --build-arg 传入（docker build --build-arg VITE_API_BASE_URL=...）
# 但 docker-compose 会自动将 environment 作为 build args 传递
ARG VITE_API_BASE_URL=http://localhost:8081/api
ARG VITE_USE_BACKEND=true
ARG VITE_WS_URL
ARG VITE_TDT_TOKEN
ARG VITE_PERSONNEL_POLL_INTERVAL
ARG VITE_REALTIME_POLL_INTERVAL
ARG VITE_WARNING_POLL_INTERVAL
ARG VITE_TDT_ATTRIBUTION

# 安全护栏：生产镜像禁止 mock 模式（VITE_USE_BACKEND=false），否则直接 fail-fast
RUN if [ "${VITE_USE_BACKEND}" != "true" ]; then \
      echo "[docker-build] ERROR: VITE_USE_BACKEND=${VITE_USE_BACKEND} — 前端生产镜像禁止 mock 模式！" >&2 && \
      echo "[docker-build] 如需构建生产镜像，请传入 --build-arg VITE_USE_BACKEND=true" >&2 && \
      exit 1; \
    fi
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_USE_BACKEND=$VITE_USE_BACKEND
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_TDT_TOKEN=$VITE_TDT_TOKEN
ENV VITE_PERSONNEL_POLL_INTERVAL=$VITE_PERSONNEL_POLL_INTERVAL
ENV VITE_REALTIME_POLL_INTERVAL=$VITE_REALTIME_POLL_INTERVAL
ENV VITE_WARNING_POLL_INTERVAL=$VITE_WARNING_POLL_INTERVAL
ENV VITE_TDT_ATTRIBUTION=$VITE_TDT_ATTRIBUTION
RUN npm run build

# Stage 2: 运行
FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY infra/nginx/frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
