VITE_USE_BACKEND=true
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_PERSONNEL_LIVE=false

# 实时同步频率（毫秒）：
#   VITE_REALTIME_POLL_INTERVAL  设备/灾害点/汇总基础轮询（兜底）
#   VITE_WARNING_POLL_INTERVAL   预警核心数据高频轮询（默认 10s）
#   VITE_PERSONNEL_POLL_INTERVAL 值守人员位置轮询（位置变化慢，低频即可）
#   VITE_USE_PERSONNEL_LIVE      生产模式：人员坐标由移动端上报后端（true），
#                                演示模式：false 时前端从人员档案本地模拟轨迹
#   VITE_WS_URL                  WebSocket 实时推送地址（预警/设备/人员增量）
VITE_REALTIME_POLL_INTERVAL=15000
VITE_WARNING_POLL_INTERVAL=10000
VITE_PERSONNEL_POLL_INTERVAL=30000
VITE_USE_PERSONNEL_LIVE=false
VITE_WS_URL=

# =============== 安全配置（生产必须修改）===============
# ⚠️  JWT_SECRET：强随机密钥（长度 ≥ 32）
#     生成方式：openssl rand -base64 48
#     应用启动时会校验，若检测到弱密钥将拒绝启动
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# JWT 过期时间（默认 2 小时）
JWT_EXPIRE_MINUTES=120

SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
FILE_BASE_URL=http://localhost:9000

# =============== PostgreSQL ===============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=disasterguard
POSTGRES_USER=disasterguard
# ⚠️ 生产环境必须修改为强随机密码
POSTGRES_PASSWORD=disasterguard123

# =============== Redis ===============
REDIS_HOST=localhost
REDIS_PORT=6379
# ⚠️ 生产环境必须修改为强随机密码（长度 ≥ 16）
#     生成方式：openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24

# =============== MinIO 对象存储 ===============
# ⚠️ 生产环境必须修改为强随机凭证（长度 ≥ 24）
#     生成方式：openssl rand -base64 32
MINIO_ROOT_USER=disasterguard
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============== EMQX MQTT Broker ===============
# ⚠️ 生产环境必须修改为强随机密码（长度 ≥ 16）
#     生成方式：openssl rand -base64 24
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
EMQX_USERNAME=disasterguard_backend
EMQX_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_HTTP_PORT=18083

# =============== TDengine 时序数据库 ===============
TDENGINE_TCP_PORT=6030
TDENGINE_HTTP_PORT=6041
TZ=Asia/Shanghai

# ============ AI 推理服务（ai-service，FastAPI）============
# 后端调用 AI 服务的基准地址；Docker 网络内为 http://ai-service:8000/api/ai
AI_SERVICE_BASE_URL=http://localhost:8000/api/ai
AI_HOST_PORT=8000
AI_ENABLED=true
AI_TIMEOUT_MS=30000
# 定时批量预测（默认关闭，开启后每天凌晨 2 点对启用的设备做预测）
AI_SCHEDULER_ENABLED=false
AI_FORECAST_HORIZON=7
AI_FORECAST_CRON=0 0 2 * * *

# ============ v1.7.0 AI 实时灾害监测（全国版）============
# 从 region 表动态加载监控区域（town/village 级别且 geo_type 非 PLAIN），
# 不依赖接入设备，AI 单独基于当地地理状况 + 天气状况输出关注/预警/异常严重结论。
#   AI_HAZARD_MONITOR_ENABLED         是否启用（默认 true）
#   AI_HAZARD_MONITOR_INTERVAL_MS    调度间隔（默认 90000ms = 90s）
#   AI_HAZARD_MONITOR_INITIAL_DELAY_MS  启动后首次执行延迟（默认 8000ms）
#   AI_HAZARD_MONITOR_MAX_REGIONS    每次最多扫描 region 数（默认 200，防超载）
#   AI_HAZARD_MONITOR_INCLUDE_PLAIN  是否包含 PLAIN（平原低风险区，默认 false 跳过）
#   AI_HAZARD_MONITOR_MIN_LEVEL      最小行政级别过滤：town（默认）/ village / district
#   AI_HAZARD_MONITOR_MIN_RISK_LEVEL AI 检测阈值：HIGH（默认）/ MEDIUM / LOW
AI_HAZARD_MONITOR_ENABLED=true
AI_HAZARD_MONITOR_INTERVAL_MS=90000
AI_HAZARD_MONITOR_INITIAL_DELAY_MS=8000
AI_HAZARD_MONITOR_MAX_REGIONS=200
AI_HAZARD_MONITOR_INCLUDE_PLAIN=false
AI_HAZARD_MONITOR_MIN_LEVEL=town
AI_HAZARD_MONITOR_MIN_RISK_LEVEL=HIGH

# ============ 地图瓦片供应商凭证 ============
# 高德地图（推荐，国内合规 + 国产高分卫星实景）：
#   VITE_AMAP_TOKEN          申请入口 https://lbs.amap.com/api/jsapi-v2/guide/abc/prepare
#                            选「Web 端 (JS API)」类型，控制台为该 Key 配置 Referer 白名单
#   VITE_AMAP_SECURITY_JS_CODE  AMap JS API 安全密钥；仅在使用官方 JS SDK 时需要
# 留空时自动降级到天地图 → ESRI Clarity；安全起见请把真实值放进本机 .env 或 .env.local
VITE_AMAP_TOKEN=请在高德开放平台申请 key 后替换此处占位
VITE_AMAP_SECURITY_JS_CODE=

# 天地图（兜底中的合规选项）：
VITE_TDT_TOKEN=
VITE_TDT_TK=

# 自定义降级源（最后兜底；不建议改）：
VITE_MAP_TILE_URL=
VITE_SATELLITE_TILE_URL=

# 渲染分辨率倍率（默认随设备；想压测/降级可显式覆盖）：
# VITE_MAP_PIXEL_RATIO=1.5

# ============ 卫星图源配置（v1.7.1 升级到"最新状态"）============
# 默认按下列优先级自动选源：
#   ① 用户显式配置 VITE_SATELLITE_TILE_URL（自定义图源）
#   ② 高德 style=6 scale=2（512px @2x，GCJ-02，2024+ 升级）
#   ③ 天地图 img_w（256px，CGCS2000，2024+ 重摄）
#   ④ ESRI Clarity（512px，WGS-84，2024-Q4 重摄，默认兜底）
#   ⑤ Mapbox Satellite-v9（256px，需配置 VITE_MAPBOX_TOKEN）
#   ⑥ Sentinel-2 真彩合成（256px，每 5 天更新无云）
#   ⑦ Google Maps 卫星（256px，备用）
#
# 自定义图源 URL（{z}/{x}/{y} 占位）：
# VITE_SATELLITE_TILE_URL=
# VITE_SENTINEL_TILE_URL=
#
# Mapbox token（可选，启用后优先级提升到第 5 位）：
#   申请入口 https://account.mapbox.com/access-tokens/
# VITE_MAPBOX_TOKEN=

# ============ 国家气象数据接入（NSMC + NMC 公开资源）============
# 后端 Java 服务相关配置（cn.disasterguard.weather.Service）：
#   WEATHER_CACHE_ENABLED      是否缓存最新帧探测结果，默认 true
#   WEATHER_CACHE_TTL_SECONDS  缓存存活秒数，默认 300 秒（5 分钟）
#   WEATHER_PROXY_ENABLED      是否启用 /api/weather/image/{kind} 代理接口，默认 true
WEATHER_CACHE_ENABLED=true
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_PROXY_ENABLED=true

# 前端气象数据接入模式：与总开关 VITE_USE_BACKEND 联动。
#   VITE_USE_BACKEND=true  → 气象走 /api/weather/* 后端代理（生产推荐，统一缓存 / 减少对外网并发）
#   VITE_USE_BACKEND=false → 浏览器直连 NSMC XML + NMC 静态产品 URL，CORS 由内置
#                             allorigins/codetabs/corsproxy 三级代理兜底（适合无后端场景）
# 详见 docs/DEVELOPER.md §17。

# ============ Copernicus Data Space（CDSE，ESA 官方 STAC + 数据）============
# 注册/管理 OAuth client：https://dataspace.copernicus.eu/profile/applications
# 点 "+ Create"，Name 任取，Application type 选 "Confidential"，勾上
# grant type "Client credentials"，Submit。创建后立即复制 Client ID + Client Secret
# （secret 只显示一次，重新生成请到详情页点 Regenerate secret）。
#
# 注意（2026-09-14 核对）：账号状态若显示 "Valid until YYYY-MM-DD"，则账号本身在
# 该时间后停用；已创建的 OAuth client 通常会同步失效，需要提前 rotate 或重新注册。
#
# ai-service 启动时会自动从 ai-service/.env 或本文件读取 COPERNICUS_CLIENT_*；
# 若留空则完全跳过 CDSE，自动降级到 Element84 Earth Search AWS + USGS Earthdata CMR
# 这两个公开 STAC，Sentinel-2 L2A / Sentinel-1 GRD 仍能正常返回（数据是同一份镜像）。
COPERNICUS_CLIENT_ID=sh-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COPERNICUS_CLIENT_SECRET=替换成从 profile/applications 复制的 secret（只显示一次）
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1/

