{
  "name": "disasterguard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss,html,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss,html,md,json}\"",
    "lint:css": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "lint:all": "npm run lint && npm run lint:css && npm run format:check",
    "fix": "node scripts/oneclick-fix.mjs && eslint src/ --fix && npm run format && npm run lint:css:fix"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "cesium": "^1.144.0",
    "lucide-vue-next": "^0.468.0",
    "ol": "^10.10.0",
    "pinia": "^2.3.1",
    "vite": "^6.0.5",
    "vite-plugin-cesium": "^1.2.23",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-recommended-vue": "^1.5.0"
  }
}
