{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-recommended-vue"
  ],
  "rules": {
    "selector-class-pattern": null,
    "no-empty-source": null,
    "custom-property-pattern": null,
    "no-descending-specificity": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "config",
          "screen",
          "variants",
          "responsive"
        ]
      }
    ]
  }
}
