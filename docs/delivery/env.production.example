# ═══════════════════════════════════════════════════════════════════
# 生产环境 .env 模板（勿直接使用；先替换所有 __GENERATE__ 占位值）
#
# 生成强随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 校验：
#   node scripts/delivery/prod-config-check.mjs .env.production
# 后端 prod profile 还会在启动时执行 ProductionConfigValidator（失败即拒绝启动）。
# ═══════════════════════════════════════════════════════════════════

# ---- 基础 ----
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FRONTEND_ORIGIN=https://disasterguard.example.com

# ---- 数据库 / 缓存 ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=disasterguard
POSTGRES_USER=disasterguard
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__

# ---- 对象存储（presigned URL 必须浏览器可达）----
MINIO_ENDPOINT=https://minio.example.com
FILE_BASE_URL=https://minio.example.com
MINIO_ROOT_USER=__GENERATE_MINIO_ACCESS_KEY__
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_SECRET_KEY__

# ---- 安全 ----
# AES-256-GCM 密钥：变更会导致历史密文永久不可解，务必安全备份
DATA_ENCRYPTION_KEY=__GENERATE_32_BYTES_BASE64__
JWT_SECRET=__GENERATE_48_BYTES_BASE64__
JWT_EXPIRE=PT2H
JWT_ISSUER=disasterguard

# 生产必须：禁用硬编码账号 fallback / 设备鉴权 / WS ticket
DEV_USERS_ENABLED=false
DEVICE_AUTH_STRICT=true
WS_REQUIRE_TICKET=true
DEBUG_ENDPOINTS=false
# 演示设备在线保鲜：生产必须 false（开启会被 ProductionConfigValidator fail-fast 拒绝启动，
# 且会掩盖真实设备断连）。dev compose / start-dev.ps1 才默认 true。
DEVICE_DEMO_PRESENCE_ENABLED=false

# ---- AI ----
AI_ENABLED=true
AI_SERVICE_BASE_URL=http://ai-service:8001/api/ai
AI_SCHEDULER_ENABLED=false
AI_HOST_PORT=127.0.0.1:8001

# ---- 端口暴露（公网只走 nginx 80/443）----
BACKEND_HOST_PORT=127.0.0.1:8080
FRONTEND_HOST_PORT=127.0.0.1:5173
MINIO_API_HOST_PORT=127.0.0.1:19000
MINIO_CONSOLE_HOST_PORT=127.0.0.1:19001

# ---- 通知 / 注册（未接网关前保持关闭）----
REGISTER_SMS_ENABLED=false
REGISTER_EMAIL_ENABLED=false
ALIYUN_SMS_ENABLED=false
NOTIFICATION_TEST_RECIPIENTS=

# ---- MQTT（按需启用；启用时必须配强凭证）----
EMQX_ENABLED=false
EMQX_USERNAME=disasterguard_backend
EMQX_PASSWORD=__GENERATE_EMQX_PASSWORD__
EMQX_NODE_COOKIE=__GENERATE_EMQX_NODE_COOKIE__
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=__GENERATE_EMQX_DASHBOARD_PASSWORD__

# ---- 前端构建变量 ----
VITE_USE_BACKEND=true
VITE_API_BASE_URL=https://disasterguard.example.com/api
VITE_WS_URL=
VITE_AMAP_TOKEN=
VITE_AMAP_SECURITY_JS_CODE=
